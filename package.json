{
  "name": "jettribe-wordpress-theme",
  "version": "1.0.0",
  "private": true,
  "description": "Jettribe custom WordPress + WooCommerce theme with 3D product experiences",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/copy-preview-assets.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint:css": "stylelint \"wp-content/themes/jettribe/src/**/*.css\"",
    "lint:ts": "eslint \"wp-content/themes/jettribe/src/**/*.{ts,tsx}\"",
    "models": "node scripts/optimize-models/index.mjs",
    "import:products": "node scripts/import-products/index.mjs",
    "package:theme": "node scripts/package-theme.mjs",
    "serve:preview": "node scripts/serve-preview.mjs"
  },
  "dependencies": {
    "detect-gpu": "^5.0.70",
    "gsap": "^3.12.7",
    "lenis": "^1.1.20",
    "three": "^0.172.0"
  },
  "devDependencies": {
    "@types/three": "^0.172.0",
    "eslint": "^9.20.0",
    "stylelint": "^16.14.1",
    "stylelint-config-standard": "^37.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.23.0",
    "vite": "^6.1.0"
  }
}
