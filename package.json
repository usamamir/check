{
  "name": "streakly",
  "version": "1.0.1",
  "description": "Streakly - a Streaks-inspired habit tracker for Windows",
  "main": "electron/main.js",
  "author": "Streakly",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack:win": "electron-builder --win portable zip --x64 --publish never",
    "pack:win:dir": "electron-builder --win dir --x64 --publish never",
    "pack:linux": "electron-builder --linux AppImage --x64 --publish never"
  },
  "build": {
    "appId": "app.streakly.desktop",
    "productName": "Streakly",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "asar": true,
    "afterPack": "./scripts/afterPack.js",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "zip",
          "arch": ["x64"]
        }
      ],
      "artifactName": "Streakly-Windows-${version}-x64.${ext}",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Streakly-Windows-${version}-x64.exe"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Utility"
    }
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  }
}
