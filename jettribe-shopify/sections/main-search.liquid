<section class="page-wrap">
  <div class="container">
    {% render 'breadcrumbs' %}
    <h1 class="page-heading" style="justify-content:flex-start;"><span>Search</span></h1>
    <form action="{{ routes.search_url }}" method="get" class="search-form search-form--page" style="max-width:640px;margin-bottom:18px;">
      <label class="visually-hidden" for="SearchPage">Search</label>
      <input id="SearchPage" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search gear">
      <input type="hidden" name="type" value="product">
      <button type="submit" aria-label="Search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#161616" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
      </button>
    </form>

    {%- if search.performed -%}
      <div class="collection-layout">
        <aside>
          {% render 'filter-list', filters: search.filters, form_action: routes.search_url, terms: search.terms, show_shop_fallback: false %}
        </aside>
        <div>
          <div class="toolbar">
            <p style="margin:0;" data-result-count>{{ search.results_count }} results for “{{ search.terms }}”</p>
          </div>
          {% paginate search.results by 24 %}
            <div class="product-grid">
              {%- for item in search.results -%}
                {%- if item.object_type == 'product' -%}
                  {% render 'product-card', product: item %}
                {%- else -%}
                  <article class="card">
                    <div class="card-body">
                      <h3 class="card-title"><a href="{{ item.url }}">{{ item.title }}</a></h3>
                      <p>{{ item.object_type | capitalize }}</p>
                    </div>
                  </article>
                {%- endif -%}
              {%- else -%}
                <div class="empty-products"><p>No results. Try a product name, vest, wetsuit, or cover.</p></div>
              {%- endfor -%}
            </div>
            {% render 'pagination', paginate: paginate %}
          {% endpaginate %}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Search", "settings": [] }
{% endschema %}
