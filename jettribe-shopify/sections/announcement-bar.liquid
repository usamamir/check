{%- if section.settings.line_1 != blank or section.settings.line_2 != blank -%}
  <div class="announcement e-promo">
    <div class="container e-promo-inner">
      {%- if section.settings.line_1 != blank -%}<strong>{{ section.settings.line_1 }}</strong>{%- endif -%}
      {%- if section.settings.line_2 != blank -%}<span>{{ section.settings.line_2 }}</span>{%- endif -%}
      <span class="e-code">SHIP400</span>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "text", "id": "line_1", "label": "Line 1", "default": "Free USA shipping now on" },
    { "type": "text", "id": "line_2", "label": "Line 2", "default": "Orders $400 and up ship free in the USA" }
  ]
}
{% endschema %}
