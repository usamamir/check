{%- if product.collections.first != blank -%}
{%- assign pool = product.collections.first.products -%}
{%- if pool.size > 1 -%}
  <section class="product-band">
    <div class="container">
      <h2 class="page-heading"><span>{{ section.settings.heading }}</span></h2>
      <div class="product-grid">
        {%- assign shown = 0 -%}
        {%- for related in pool -%}
          {%- if related.id != product.id and shown < section.settings.limit -%}
            {% render 'product-card', product: related %}
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Related products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    { "type": "range", "id": "limit", "label": "Products", "min": 4, "max": 8, "step": 1, "default": 4 }
  ]
}
{% endschema %}
