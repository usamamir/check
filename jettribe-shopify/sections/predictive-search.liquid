{%- if predictive_search.performed -%}
  <div class="predictive">
    {%- for product in predictive_search.resources.products -%}
      {%- liquid
        assign block_card = false
        assign title_l = product.title | downcase
        assign handle_l = product.handle | downcase
        if title_l contains 'promo card' or title_l contains 'promotional' or title_l contains 'gift card' or title_l contains 'gift certificate' or title_l contains 'restrictions apply'
          assign block_card = true
        endif
        if handle_l contains 'promo-card' or handle_l contains 'promotional' or handle_l contains 'gift-card' or handle_l contains 'egift' or handle_l contains 'e-gift'
          assign block_card = true
        endif
      -%}
      {%- unless block_card -%}
        {%- if product.featured_image -%}
          <a href="{{ product.url }}">
            <img src="{{ product.featured_image | image_url: width: 120 }}" alt="{{ product.title | escape }}" width="54" height="54">
            <span>{{ product.title }}</span>
            <span>{{ product.price | money }}</span>
          </a>
        {%- endif -%}
      {%- endunless -%}
    {%- endfor -%}
    {%- for page in predictive_search.resources.pages -%}
      <a href="{{ page.url }}"><span></span><span>{{ page.title }}</span><span>Page</span></a>
    {%- endfor -%}
    <a class="view-all" href="{{ routes.search_url }}?q={{ predictive_search.terms | url_encode }}&type=product">View all results</a>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Predictive search",
  "settings": []
}
{% endschema %}
