<div class="e-util">
  <div class="container e-util-inner">
    <p>Free USA shipping on orders $400+. <a href="/pages/shipping-info">Learn more</a></p>
    <p class="e-util-links">
      <a href="tel:{{ section.settings.phone | replace: ' ', '' | replace: '.', '' }}">{{ section.settings.phone }}</a>
      <span>|</span>
      <a href="/pages/financing">Financing</a>
      <span>|</span>
      <a href="{{ settings.returns_url }}">Returns</a>
    </p>
  </div>
</div>

<header class="header e-header" role="banner">
  <div class="container e-header-row">
    <button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="SiteNav">
      <span></span>
      <span class="visually-hidden">Menu</span>
    </button>
    <a class="logo" href="{{ routes.root_url }}">
      {%- if section.settings.logo != blank -%}
        <img src="{{ section.settings.logo | image_url: width: 420 }}" alt="{{ shop.name }}" width="210" height="48">
      {%- elsif settings.logo != blank -%}
        <img src="{{ settings.logo | image_url: width: 420 }}" alt="{{ shop.name }}" width="210" height="48">
      {%- else -%}
        <img src="{{ 'logo.png' | asset_url }}" alt="{{ shop.name }}" width="210" height="48">
      {%- endif -%}
    </a>
    <form class="search-form e-search" action="{{ routes.search_url }}" method="get" role="search">
      <label class="visually-hidden" for="HeaderSearch">Search</label>
      <span class="e-search-all">All</span>
      <input id="HeaderSearch" type="search" name="q" placeholder="Search for gear" autocomplete="off" data-predictive>
      <input type="hidden" name="type" value="product">
      <button type="submit" aria-label="Search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
      </button>
      <div class="predictive" data-predictive-results hidden></div>
    </form>
    <div class="e-icons">
      <a class="e-icon" href="{{ routes.account_login_url }}" aria-label="Account">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="8" r="3.2"/><path d="M5 19.2c1.4-3 3.8-4.5 7-4.5s5.6 1.5 7 4.5"/></svg>
      </a>
      <a class="e-icon cart-chip" href="{{ routes.cart_url }}" data-open-cart aria-label="Cart">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 7h15l-1.5 9h-12z"/><path d="M6 7L5 4H2"/><circle cx="9" cy="20" r="1.2" fill="currentColor"/><circle cx="18" cy="20" r="1.2" fill="currentColor"/></svg>
        <span class="cart-count" data-cart-count>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>

  <div class="container e-nav-row">
    <nav class="site-nav" id="SiteNav" data-site-nav aria-label="Primary">
      {%- if settings.menu_source == 'shopify' and linklists[settings.menu].links.size > 0 -%}
        {% render 'nav-links', menu: linklists[settings.menu] %}
      {%- else -%}
        {% render 'nav-jettribe' %}
      {%- endif -%}
      <div class="mobile-utilities">
        <a href="tel:{{ section.settings.phone | replace: ' ', '' | replace: '.', '' }}">{{ section.settings.phone }}</a>
        <a href="#" data-open-wish>Wishlist</a>
        <a href="{{ settings.returns_url }}">Returns</a>
        <a href="{{ routes.account_login_url }}">Sign in</a>
        <a href="{{ settings.gift_card_link }}">Gift certificates</a>
      </div>
    </nav>
    <a class="e-help" href="/pages/contact">Rider support</a>
  </div>
</header>

<div class="e-trust">
  <div class="container e-trust-row">
    <span>Free shipping over $400</span>
    <span>Rider support 9am–4pm PST</span>
    <span>Hassle-free returns</span>
    <span>Born in Southern California</span>
  </div>
</div>

{%- if settings.show_translate -%}
  <script>
    function googleTranslateElementInit() {
      new google.translate.TranslateElement({ pageLanguage: 'en', autoDisplay: false }, 'google_translate_element');
    }
  </script>
  <script src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
{%- endif -%}

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "951 246 3147" }
  ]
}
{% endschema %}
