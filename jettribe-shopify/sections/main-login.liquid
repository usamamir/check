<section class="page-wrap">
  <div class="container narrow">
    <h1>Sign in</h1>
    {% form 'customer_login' %}
      {{ form.errors | default_errors }}
      <div class="field">
        <label for="CustomerEmail">Email</label>
        <input id="CustomerEmail" type="email" name="customer[email]" autocomplete="email" required>
      </div>
      <div class="field">
        <label for="CustomerPassword">Password</label>
        <input id="CustomerPassword" type="password" name="customer[password]" autocomplete="current-password">
      </div>
      <button class="btn" type="submit">Sign in</button>
      <p><a href="#recover" onclick="document.getElementById('Recover').hidden=false;return false;">Forgot password?</a></p>
    {% endform %}
    <div id="Recover" hidden>
      <h2>Reset password</h2>
      {% form 'recover_customer_password' %}
        {{ form.errors | default_errors }}
        {%- if form.posted_successfully? -%}
          <p class="form-success">Check your email for a reset link.</p>
        {%- endif -%}
        <div class="field">
          <label for="RecoverEmail">Email</label>
          <input id="RecoverEmail" type="email" name="email" required>
        </div>
        <button class="btn" type="submit">Email reset link</button>
      {% endform %}
    </div>
    <p>New rider? <a href="{{ routes.account_register_url }}">Create an account</a></p>
  </div>
</section>

{% schema %}
{ "name": "Login", "settings": [] }
{% endschema %}
