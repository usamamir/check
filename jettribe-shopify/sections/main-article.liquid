<article class="page-wrap">
  <div class="container" style="max-width:900px;">
    {% render 'breadcrumbs' %}
    <h1>{{ article.title }}</h1>
    <p>{{ article.published_at | date: "%B %d, %Y" }}{% if article.author %} · {{ article.author }}{% endif %}</p>
    {%- if article.image -%}
      <p class="article-hero"><img src="{{ article.image | image_url: width: 1600 }}" alt="{{ article.image.alt | escape }}" width="1200" height="675"></p>
    {%- endif -%}
    <div class="rte">{{ article.content }}</div>
    {%- if blog.comments_enabled? -%}
      <h2>Comments</h2>
      {% paginate article.comments by 10 %}
        {%- for comment in article.comments -%}
          <div style="border-top:1px solid #eee; padding:12px 0;">
            <strong>{{ comment.author }}</strong>
            <div>{{ comment.content }}</div>
          </div>
        {%- endfor -%}
        {% render 'pagination', paginate: paginate %}
      {% endpaginate %}
      {% form 'new_comment', article %}
        {{ form.errors | default_errors }}
        {%- if form.posted_successfully? -%}
          <p class="form-success">Comment received.</p>
        {%- endif -%}
        <div class="field"><label for="CommentAuthor">Name</label><input id="CommentAuthor" name="comment[author]" required></div>
        <div class="field"><label for="CommentEmail">Email</label><input id="CommentEmail" type="email" name="comment[email]" required></div>
        <div class="field"><label for="CommentBody">Comment</label><textarea id="CommentBody" name="comment[body]" required></textarea></div>
        <button class="btn" type="submit">Post comment</button>
      {% endform %}
    {%- endif -%}
  </div>
</article>

{% schema %}
{ "name": "Article", "settings": [] }
{% endschema %}
