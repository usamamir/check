<section class="testimonials">
  <div class="container" data-slider data-autoplay>
    <div class="quote-mark" aria-hidden="true">&ldquo;</div>
    {%- for block in section.blocks -%}
      <blockquote class="testimonial{% if forloop.first %} is-active{% endif %}" data-slide {{ block.shopify_attributes }}>
        <p>{{ block.settings.quote }}</p>
        <div class="author">- {{ block.settings.author }}</div>
      </blockquote>
    {%- endfor -%}
    <div class="slider-dots" data-dots></div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "blocks": [
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "The gear looks and feels amazing." },
        { "type": "text", "id": "author", "label": "Author", "default": "Jettribe rider" }
      ]
    }
  ],
  "presets": [{ "name": "Testimonials" }]
}
{% endschema %}
