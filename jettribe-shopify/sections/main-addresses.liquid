<section class="page-wrap">
  <div class="container">
    <h1>Addresses</h1>
    <div class="account-layout">
      {% render 'account-nav' %}
      <div>
        <h2>Add address</h2>
        {% form 'customer_address', customer.new_address %}
          {{ form.errors | default_errors }}
          <div class="field"><label for="AddressFirstNew">First name</label><input id="AddressFirstNew" name="address[first_name]" value="{{ form.first_name }}"></div>
          <div class="field"><label for="AddressLastNew">Last name</label><input id="AddressLastNew" name="address[last_name]" value="{{ form.last_name }}"></div>
          <div class="field"><label for="AddressCompanyNew">Company</label><input id="AddressCompanyNew" name="address[company]" value="{{ form.company }}"></div>
          <div class="field"><label for="Address1New">Address</label><input id="Address1New" name="address[address1]" value="{{ form.address1 }}"></div>
          <div class="field"><label for="Address2New">Apartment</label><input id="Address2New" name="address[address2]" value="{{ form.address2 }}"></div>
          <div class="field"><label for="AddressCityNew">City</label><input id="AddressCityNew" name="address[city]" value="{{ form.city }}"></div>
          <div class="field">
            <label for="AddressCountryNew">Country</label>
            <select id="AddressCountryNew" name="address[country]" data-default="{{ form.country }}" data-country-select data-province="AddressProvinceNew" data-province-container="AddressProvinceContainerNew">{{ all_country_option_tags }}</select>
          </div>
          <div class="field" id="AddressProvinceContainerNew">
            <label for="AddressProvinceNew">State</label>
            <select id="AddressProvinceNew" name="address[province]" data-default="{{ form.province }}"></select>
          </div>
          <div class="field"><label for="AddressZipNew">Postal code</label><input id="AddressZipNew" name="address[zip]" value="{{ form.zip }}"></div>
          <div class="field"><label for="AddressPhoneNew">Phone</label><input id="AddressPhoneNew" name="address[phone]" value="{{ form.phone }}"></div>
          <button class="btn" type="submit">Save address</button>
        {% endform %}

        <h2 style="margin-top:28px;">Saved addresses</h2>
        {%- for address in customer.addresses -%}
          <article class="finance-card" style="margin-bottom:12px;">
            {{ address | format_address }}
            {%- if address == customer.default_address -%}
              <p><strong>Default address</strong></p>
            {%- endif -%}
            <form method="post" action="{{ routes.account_addresses_url }}/{{ address.id }}">
              <input type="hidden" name="_method" value="delete">
              <button class="remove-link" type="submit">Delete</button>
            </form>
          </article>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>
<script src="{{ 'shopify_common.js' | shopify_asset_url }}" defer></script>

{% schema %}
{ "name": "Addresses", "settings": [] }
{% endschema %}
