<section class="page-wrap" style="padding-top:0;">
  <div class="container">
    {% render 'breadcrumbs' %}
  </div>
  <div class="container">
    <div class="product">
      <div class="product-gallery">
        {%- assign current = product.selected_or_first_available_variant -%}
        {%- if product.featured_image -%}
          <div class="product-gallery-main">
            <img
              data-gallery-main
              src="{{ current.featured_image | default: product.featured_image | image_url: width: 1400 }}"
              alt="{{ product.featured_image.alt | escape }}"
              width="1200"
              height="1200"
            >
          </div>
        {%- endif -%}
        {%- if product.media.size > 1 -%}
          <div class="thumbs">
            {%- for media in product.media -%}
              {%- if media.media_type == 'image' -%}
                <button
                  type="button"
                  class="thumb{% if forloop.first %} is-active{% endif %}"
                  data-thumb
                  data-src="{{ media | image_url: width: 1400 }}"
                  data-alt="{{ media.alt | escape }}"
                  aria-label="Show image {{ forloop.index }}"
                >
                  <img src="{{ media | image_url: width: 160 }}" alt="{{ media.alt | escape }}" width="74" height="74">
                </button>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="product-info">
        {%- if product.vendor != blank -%}
          <p style="margin-bottom:6px;">{{ product.vendor }}</p>
        {%- endif -%}
        <h1 class="product-title">{{ product.title }}</h1>
        <div class="product-price price" data-product-price>
          {%- if current.compare_at_price > current.price -%}
            <s>{{ current.compare_at_price | money }}</s>
          {%- endif -%}
          Now: {{ current.price | money }}
        </div>
        {% render 'paypal-message', placement: 'product', amount: current.price %}
        {%- liquid
          assign jt_fallback_sku = ''
          for variant in product.variants
            if variant.sku != blank
              if jt_fallback_sku == blank or variant.sku.size < jt_fallback_sku.size
                assign jt_fallback_sku = variant.sku
              endif
            endif
          endfor
          assign jt_sku = current.sku
          if jt_sku == blank
            assign jt_sku = jt_fallback_sku
          endif
        -%}
        <p class="sku" data-sku data-fallback-sku="{{ jt_fallback_sku | escape }}">{% if jt_sku != blank %}SKU: {{ jt_sku }}{% endif %}</p>

        {% form 'product', product, class: 'product-form', data-product-form: 'true', enctype: 'multipart/form-data' %}
          <input type="hidden" name="id" value="{{ current.id }}" data-variant-id>

          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              {%- assign option_key = option.name | downcase -%}
              {%- assign option_is_color = false -%}
              {%- if option_key contains 'color' or option_key contains 'colour' -%}
                {%- assign option_is_color = true -%}
              {%- endif -%}
              <div class="option-label">{{ option.name }}</div>
              <div class="option-values{% if option_is_color %} option-values--color{% endif %}" data-option-index="{{ forloop.index0 }}" data-option-name="{{ option.name | escape }}">
                {%- for value in option.values -%}
                  <label class="{% if option_is_color %}swatch {% endif %}{% if option.selected_value == value %}is-selected{% endif %}">
                    <input
                      type="radio"
                      name="option-{{ option.position }}"
                      value="{{ value | escape }}"
                      data-option-input
                      {% if option.selected_value == value %}checked{% endif %}
                    >
                    {%- if option_is_color -%}
                      {%- capture swatch -%}{% render 'swatch-color', label: value %}{%- endcapture -%}
                      <i style="--swatch: {{ swatch | strip }};"></i>
                    {%- endif -%}
                    <span>{% if option_key contains 'size' %}{{ value | replace: ' / ', '/' | replace: '/ ', '/' | replace: ' /', '/' }}{% else %}{{ value }}{% endif %}</span>
                  </label>
                {%- endfor -%}
              </div>
            {%- endfor -%}
          {%- endunless -%}

          {%- if product.selling_plan_groups.size > 0 -%}
            <div class="field">
              <label for="SellingPlan">Purchase option</label>
              <select id="SellingPlan" name="selling_plan">
                <option value="">One-time purchase</option>
                {%- for group in product.selling_plan_groups -%}
                  {%- for plan in group.selling_plans -%}
                    <option value="{{ plan.id }}">{{ plan.name }}</option>
                  {%- endfor -%}
                {%- endfor -%}
              </select>
            </div>
          {%- endif -%}

          {%- liquid
            assign jt_custom = false
            assign jt_has_number = false
            assign jt_has_name = false
            assign jt_has_photo = false
            assign title_down = product.title | downcase
            if product.tags contains 'custom' or product.tags contains 'customizable' or title_down contains 'custom' or title_down contains 'your name'
              assign jt_custom = true
            endif
            for tag in product.tags
              if tag contains 'text-option:'
                assign jt_custom = true
                assign option_name = tag | remove: 'text-option:'
                assign option_key = option_name | downcase
                if option_key contains 'number'
                  assign jt_has_number = true
                endif
                if option_key contains 'name'
                  assign jt_has_name = true
                endif
                if option_key contains 'photo' or option_key contains 'image' or option_key contains 'upload'
                  assign jt_has_photo = true
                endif
              endif
            endfor
          -%}
          {%- if section.settings.show_custom_note or product.tags contains 'custom' or product.tags contains 'customizable' -%}
            <div class="field">
              <label for="CustomNote">Customization notes</label>
              <textarea id="CustomNote" name="properties[Customization]" placeholder="Colors, name, size notes"></textarea>
            </div>
          {%- endif -%}
          {%- for tag in product.tags -%}
            {%- if tag contains 'text-option:' -%}
              {%- assign option_name = tag | remove: 'text-option:' -%}
              {%- assign option_key = option_name | downcase -%}
              <div class="field">
                {%- if option_key contains 'disclaimer' -%}
                  <label class="check-line" for="TextOption-{{ forloop.index }}">
                    <input id="TextOption-{{ forloop.index }}" type="checkbox" name="properties[{{ option_name }}]" value="Acknowledged">
                    <span>I understand custom gear is made to order and ships later than in-stock items.</span>
                  </label>
                {%- elsif option_key contains 'photo' or option_key contains 'image' or option_key contains 'upload' -%}
                  <label for="TextOption-{{ forloop.index }}">{{ option_name }}</label>
                  <input class="input" id="TextOption-{{ forloop.index }}" type="file" accept="image/jpeg,image/png,image/webp,image/gif" name="properties[{{ option_name }}]">
                  <p class="file-note">The photo is saved with this item on the order.</p>
                {%- else -%}
                  <label for="TextOption-{{ forloop.index }}">{{ option_name }}</label>
                  <input class="input" id="TextOption-{{ forloop.index }}" type="text" name="properties[{{ option_name }}]">
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
          {%- if jt_custom and jt_has_number != true -%}
            {%- if jt_has_name or jt_has_photo -%}
              <div class="field">
                <label for="RiderNumber">Rider Number</label>
                <input class="input" id="RiderNumber" type="text" name="properties[Rider Number]">
              </div>
            {%- endif -%}
          {%- endif -%}
          {%- if jt_custom -%}
            <p class="note note--plain custom-ship">Custom gear is made to order and ships later than in-stock items.</p>
          {%- endif -%}

          <div class="qty-row">
            <label for="Quantity">Qty</label>
            <input class="input" id="Quantity" type="number" name="quantity" min="1" value="1">
          </div>

          <p class="form-errors" data-product-error hidden></p>
          <div class="product-actions">
            <button class="btn" type="submit" name="add" data-add-button {% unless product.available %}disabled{% endunless %}>
              {%- if product.available -%}Add to Cart{%- else -%}Out of Stock{%- endif -%}
            </button>
            <a class="btn btn--dark" href="/checkout">Checkout</a>
            {{ form | payment_button }}
            <button class="btn btn--ghost" type="button" data-wish-toggle="{{ product.handle }}">Wishlist</button>
            <button
              class="btn btn--ghost"
              type="button"
              data-compare-button
              data-compare-add
              data-id="{{ product.id }}"
              data-title="{{ product.title | escape }}"
              data-price="{{ product.price }}"
              data-img="{% if product.featured_image %}{{ product.featured_image | image_url: width: 480 }}{% endif %}"
              data-url="{{ product.url }}"
            >Compare</button>
          </div>
        {% endform %}

        <div class="pay-note">
          <p>Pay with PayPal, Visa, Mastercard, American Express, or Discover.</p>
          <p>Pay over time with Klarna or <a href="/search?jtpage=financing">Bread financing</a>.</p>
          {%- if settings.klarna_client_id != blank and settings.klarna_product_placement_id != blank -%}
            <klarna-placement
              data-id="{{ settings.klarna_product_placement_id }}"
              data-theme="dark"
              data-purchase-amount="{{ current.price }}"
            ></klarna-placement>
          {%- endif -%}
          {% render 'payment-icons' %}
        </div>
      </div>
    </div>

    <div class="product-lower">
      <div class="tabs" role="tablist">
        <button class="is-active" type="button" data-tab="description">Description</button>
        <button type="button" data-tab="shipping">Shipping</button>
        <button type="button" data-tab="reviews">Reviews</button>
      </div>
      <div class="tab-panel rte is-active" data-tab-panel="description">
        {{ product.description }}
      </div>
      <div class="tab-panel rte" data-tab-panel="shipping">
        {{ section.settings.shipping_text }}
      </div>
      <div class="tab-panel" data-tab-panel="reviews">
        <p>Product reviews appear here after a reviews app is installed. Add the app in the Apps section under this product.</p>
      </div>
    </div>
  </div>

  <script type="application/json" data-product-json>{{ product | json }}</script>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "name": {{ product.title | json }},
      "description": {{ product.description | strip_html | truncate: 500 | json }},
      "sku": {{ current.sku | json }},
      "brand": { "@type": "Brand", "name": {{ product.vendor | default: shop.name | json }} },
      "offers": {
        "@type": "Offer",
        "priceCurrency": {{ shop.currency | json }},
        "price": "{{ current.price | divided_by: 100.0 }}",
        "availability": "https://schema.org/{% if current.available %}InStock{% else %}OutOfStock{% endif %}",
        "url": {{ canonical_url | json }}
      }
    }
  </script>
</section>

{% schema %}
{
  "name": "Product",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_custom_note",
      "label": "Show customization note on every product",
      "default": false
    },
    {
      "type": "richtext",
      "id": "shipping_text",
      "label": "Shipping tab",
      "default": "<p>Free USA shipping on orders of $400 or more. Shipping cost is calculated at checkout for smaller orders. Rider support: 951.246.3147, Monday through Friday, 9am to 4pm PST.</p>"
    }
  ]
}
{% endschema %}
