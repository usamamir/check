<section class="page-wrap">
  <div class="container narrow" style="text-align:center;">
    <h1>Page not found</h1>
    <p>That link does not match a page on the Shopify store yet. Try search, or head back to the gear.</p>
    <form action="{{ routes.search_url }}" method="get" class="field">
      <input type="search" name="q" placeholder="Search">
      <button class="btn" type="submit" style="margin-top:10px;">Search</button>
    </form>
    <p><a class="btn" href="{{ routes.root_url }}">Back home</a></p>
  </div>
</section>

{% schema %}
{ "name": "404", "settings": [] }
{% endschema %}
