<section class="page-wrap">
  <div class="container narrow">
    <h1>Activate account</h1>
    {% form 'activate_customer_password' %}
      {{ form.errors | default_errors }}
      <div class="field"><label for="Password">Password</label><input id="Password" type="password" name="customer[password]" required></div>
      <div class="field"><label for="PasswordConfirm">Confirm password</label><input id="PasswordConfirm" type="password" name="customer[password_confirmation]" required></div>
      <button class="btn" type="submit">Activate</button>
      <button class="btn btn--ghost" type="submit" name="decline">Decline</button>
    {% endform %}
  </div>
</section>

{% schema %}
{ "name": "Activate account", "settings": [] }
{% endschema %}
