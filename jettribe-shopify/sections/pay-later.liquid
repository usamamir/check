<section class="paylater-strip">
  <div class="container">
    {{ section.settings.text }}
    {%- if section.settings.link_label != blank -%}
      <a href="{{ section.settings.link }}">{{ section.settings.link_label }}</a>
    {%- endif -%}
    {% render 'payment-icons' %}
  </div>
</section>

{% schema %}
{
  "name": "Pay later strip",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Pay with PayPal, Visa, Mastercard, American Express, or Discover."
    },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "See financing" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Pay later strip" }]
}
{% endschema %}
