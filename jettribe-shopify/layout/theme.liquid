<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_black }}">
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  {% render 'meta-tags' %}
  {{ content_for_header }}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <style>
    :root {
      --red: {{ settings.color_red }};
      --black: {{ settings.color_black }};
      --blue: {{ settings.color_blue }};
      --text: {{ settings.color_text }};
      --heading: {{ settings.color_heading }};
      --header: {{ settings.color_black }};
    }
  </style>
  <script>
    document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    window.Jettribe = {
      moneyFormat: {{ shop.money_format | json }},
      cartType: {{ settings.cart_type | json }},
      freeShipping: {{ settings.free_shipping_threshold | times: 100 }},
      routes: {
        root: {{ routes.root_url | json }},
        cart: {{ routes.cart_url | json }},
        search: {{ routes.search_url | json }}
      }
    };
  </script>
</head>
<body class="template-{{ request.page_type | handle }}">
  <a class="skip-link" href="#MainContent">Skip to content</a>
  {% sections 'header-group' %}
  <main id="MainContent" class="main" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>
  {% sections 'footer-group' %}

  {% render 'cart-drawer' %}
  {% render 'quick-view' %}
  {% render 'wishlist-drawer' %}
  {% render 'compare-bar' %}

  <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  {% if settings.klarna_client_id != blank %}
    <script
      async
      src="https://osm.klarnaservices.com/lib.js"
      data-environment="production"
      data-client-id="{{ settings.klarna_client_id | escape }}"
    ></script>
  {% endif %}
</body>
</html>
