<div class="payment-row">
  {%- if settings.show_payment_image -%}
    <img
      src="{{ 'payment-ic.png' | asset_url }}"
      alt="PayPal, Visa, Discover, Mastercard, and American Express"
      width="294"
      height="32"
    >
  {%- endif -%}
  {%- if settings.show_klarna_badge -%}
    <img src="{{ 'pay-klarna.png' | asset_url }}" alt="Klarna" width="79" height="32">
  {%- endif -%}
  {%- if settings.show_bread_badge -%}
    <img src="{{ 'pay-bread.png' | asset_url }}" alt="Bread" width="72" height="32">
  {%- endif -%}
  {%- if settings.show_shop_pay_badge -%}
    <span class="pay-badge">Shop Pay</span>
  {%- endif -%}
</div>
