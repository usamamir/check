{%- liquid
  comment
    Universal rule: show the lowest price among available variants with a real price.
    Never prefer a $0.00 / out-of-stock default when another variation is buyable.
  endcomment
  assign show_price = 0
  assign show_compare = 0
  assign found_available = false

  for variant in product.variants
    if variant.available and variant.price > 0
      if show_price == 0 or variant.price < show_price
        assign show_price = variant.price
      endif
      if variant.compare_at_price > show_compare
        assign show_compare = variant.compare_at_price
      endif
      assign found_available = true
    endif
  endfor

  unless found_available
    for variant in product.variants
      if variant.price > 0
        if show_price == 0 or variant.price < show_price
          assign show_price = variant.price
        endif
        if variant.compare_at_price > show_compare
          assign show_compare = variant.compare_at_price
        endif
      endif
    endfor
  endunless

  if show_price == 0
    assign show_price = product.price
    assign show_compare = product.compare_at_price
  endif
  if show_price == 0 and show_compare > 0
    assign show_price = show_compare
    assign show_compare = 0
  endif
-%}
{%- if show_compare > show_price -%}
  <s>{{ show_compare | money }}</s>
{%- endif -%}
<span>Now: {{ show_price | money }}</span>
{%- if product.price_varies and show_compare <= show_price -%}
  <span class="visually-hidden">From</span>
{%- endif -%}
