<div class="compare-bar" data-compare-bar hidden>
  <div class="compare-bar-inner">
    <p data-compare-label>Compare</p>
    <div class="compare-thumbs" data-compare-thumbs></div>
    <button class="btn" type="button" data-compare-open>Compare</button>
    <button class="compare-clear" type="button" data-compare-clear>Clear</button>
  </div>
</div>
<div class="compare-modal" data-compare-modal hidden>
  <div class="compare-panel" role="dialog" aria-modal="true" aria-label="Compare products">
    <div class="compare-panel-head">
      <h2>Compare</h2>
      <button type="button" data-compare-close>Close</button>
    </div>
    <div class="compare-grid" data-compare-grid></div>
  </div>
</div>
