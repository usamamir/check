<ul class="nav-list">
  {%- for link in menu.links -%}
    <li class="nav-item{% if link.links.size > 0 %} has-sub{% endif %}">
      <a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>{{ link.title }}</a>
      {%- if link.links.size > 0 -%}
        <div class="nav-sub">
          <ul class="mega-side">
            {%- for child in link.links -%}
              <li class="{% if child.links.size > 0 %}nav-item has-sub{% endif %}">
                <a href="{{ child.url }}">{{ child.title }}</a>
                <div class="mega-fly">
                  <a class="mega-go" href="{{ child.url }}">Shop all {{ child.title }}</a>
                  {%- for grandchild in child.links -%}
                    <a href="{{ grandchild.url }}">{{ grandchild.title }}</a>
                  {%- endfor -%}
                </div>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </li>
  {%- endfor -%}
</ul>
