<ul class="nav-list">
  {%- for link in menu.links -%}
    <li class="nav-item{% if link.links.size > 0 %} has-sub{% endif %}">
      <a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>{{ link.title }}</a>
      {%- if link.links.size > 0 -%}
        <div class="nav-sub">
          <div class="container">
            <div class="mega-grid">
              {%- for child in link.links -%}
                <div class="mega-col">
                  <a class="mega-head" href="{{ child.url }}">{{ child.title }}</a>
                  {%- if child.links.size > 0 -%}
                    <a class="mega-all" href="{{ child.url }}">View all</a>
                    {%- for grandchild in child.links -%}
                      <a href="{{ grandchild.url }}">{{ grandchild.title }}</a>
                      {%- if grandchild.links.size > 0 -%}
                        {%- for great in grandchild.links -%}
                          <a class="mega-nest" href="{{ great.url }}">{{ great.title }}</a>
                        {%- endfor -%}
                      {%- endif -%}
                    {%- endfor -%}
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </div>
          </div>
        </div>
      {%- endif -%}
    </li>
  {%- endfor -%}
</ul>
