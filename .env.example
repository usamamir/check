# SupplyScout — copy to .env.local and fill in what you have.
# All keys can also be set/overridden on the Settings page (stored in SQLite).

# --- Discovery (at least one recommended; manual import works with none) ---
BRAVE_SEARCH_API_KEY=
SERPAPI_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# --- Optional LLM (OpenAI-compatible or Anthropic) ---
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

# --- Optional SMTP for one-by-one sending ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Crawl identity ---
USER_AGENT_CONTACT=you@example.com
